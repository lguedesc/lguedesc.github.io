{% assign m = site.data.metrics %}
{% if m %}
  {% assign t = site.data.strings[site.active_lang] | default: site.data.strings.en %}
  {% if m.scopus %}
    {% assign primary = m.scopus -%}
    {%- assign primary_name = 'Scopus' -%}
    {%- assign primary_url = m.profiles.scopus %}
  {% else %}
    {% assign primary = m.openalex -%}
    {%- assign primary_name = 'OpenAlex' -%}
    {%- assign primary_url = m.profiles.openalex %}
  {% endif %}

  <section class="metrics">
    <div class="metrics-body">
      <div class="metrics-tiles">
        <div class="metrics-tile">
          <span class="metrics-value">{{ primary.citations }}</span>
          <span class="metrics-label">{{ t.citations }}</span>
        </div>
        <div class="metrics-tile">
          <span class="metrics-value">{{ primary.h_index }}</span>
          <span class="metrics-label">{{ t.h_index }}</span>
        </div>
        <div class="metrics-tile">
          <span class="metrics-value">{% bibliography_count --query @article %}</span>
          <span class="metrics-label">{{ t.journal_papers }}</span>
        </div>
        <div class="metrics-tile">
          <span class="metrics-value">{% bibliography_count --query @inproceedings %}</span>
          <span class="metrics-label">{{ t.conference_papers }}</span>
        </div>
      </div>

      {% if m.openalex.citations_per_year %}
        {% assign current_year = 'now' | date: '%Y' %}
        <div class="metrics-chart-wrap">
          <h3 class="metrics-chart-title">
            {{ t.citations_per_year }}
            <small>(OpenAlex)</small>
          </h3>
          <div
            id="citations-chart"
            class="metrics-chart"
            role="img"
            aria-label="{{ t.citations_per_year }}: {% for y in m.openalex.citations_per_year %}{{ y[0] }}{% if y[0] == current_year %} ({{ t.partial_year }}){% endif %} {{ y[1] }}{% unless forloop.last %}, {% endunless %}{% endfor %}"
            data-years="{% for y in m.openalex.citations_per_year %}{{ y[0] }}{% unless forloop.last %},{% endunless %}{% endfor %}"
            data-values="{% for y in m.openalex.citations_per_year %}{{ y[1] }}{% unless forloop.last %},{% endunless %}{% endfor %}"
            data-current-year="{{ current_year }}"
            data-label="{{ t.citations }}"
            data-partial="{{ t.partial_year }}"
          ></div>
        </div>
      {% endif %}
    </div>

    <p class="metrics-meta">
      {{ t.source }}: <a href="{{ primary_url }}" target="_blank" rel="noopener noreferrer">{{ primary_name }}</a> · {{ t.citations_by_source }}:
      {% if m.scopus -%}
        <a href="{{ m.profiles.scopus }}" target="_blank" rel="noopener noreferrer">Scopus</a> {{ m.scopus.citations }},
      {%- endif %}
      {% if m.wos -%}
        <a href="{{ m.profiles.wos }}" target="_blank" rel="noopener noreferrer">Web of Science</a> {{ m.wos.citations }},
      {%- endif %}
      {% if m.dimensions -%}
        <a href="{{ m.profiles.dimensions }}" target="_blank" rel="noopener noreferrer">Dimensions</a> {{ m.dimensions.citations }},
      {%- endif %}
      <a href="{{ m.profiles.openalex }}" target="_blank" rel="noopener noreferrer">OpenAlex</a> {{ m.openalex.citations }}
      {% if m.updated -%}
        · {{ t.metrics_updated }}
        {% include date.liquid date=m.updated format='long' -%}
      {%- endif %}
    </p>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('citations-chart');
      if (!el || typeof echarts === 'undefined') return;
      var years = el.dataset.years.split(',');
      var values = el.dataset.values.split(',').map(Number);
      var currentYear = el.dataset.currentYear;
      var chart = echarts.init(el, null, { renderer: 'svg' });
      // Three round steps on the y axis, so labels stay readable in a short chart
      var step = Math.max(1, Math.ceil(Math.max.apply(null, values) / 3 / 5) * 5);

      function render() {
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        var css = getComputedStyle(document.documentElement);
        var text = css.getPropertyValue('--global-text-color').trim();
        var muted = css.getPropertyValue('--global-text-color-light').trim();
        var surface = css.getPropertyValue('--global-bg-color').trim();
        var bar = dark ? '#d9782b' : '#d76c23';
        var grid = dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';

        chart.setOption({
          animationDuration: 600,
          grid: { left: 8, right: 8, top: 12, bottom: 0, containLabel: true },
          tooltip: {
            trigger: 'item',
            backgroundColor: surface,
            borderColor: grid,
            textStyle: { color: text },
            formatter: function (p) {
              var partial = p.name === currentYear ? ' (' + el.dataset.partial + ')' : '';
              return '<b>' + p.name + partial + '</b><br>' + el.dataset.label + ': ' + p.value;
            },
          },
          xAxis: {
            type: 'category',
            data: years,
            axisTick: { show: false },
            axisLine: { lineStyle: { color: grid } },
            axisLabel: { color: muted },
          },
          yAxis: {
            type: 'value',
            interval: step,
            max: step * 3,
            splitLine: { lineStyle: { color: grid } },
            axisLabel: { color: muted },
          },
          series: [
            {
              type: 'bar',
              barMaxWidth: 24,
              data: values.map(function (v, i) {
                var partial = years[i] === currentYear;
                return {
                  value: v,
                  itemStyle: {
                    color: bar,
                    opacity: partial ? 0.55 : 1,
                    borderRadius: [4, 4, 0, 0],
                    decal: partial ? { symbol: 'rect', dashArrayX: [1, 0], dashArrayY: [2, 4], rotation: Math.PI / 4, color: surface } : null,
                  },
                };
              }),
            },
          ],
        });
      }

      render();
      new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      new ResizeObserver(function () {
        chart.resize();
      }).observe(el);
    });
  </script>
{% endif %}
