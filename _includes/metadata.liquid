{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% assign t_meta = site.data.strings[site.active_lang] | default: site.data.strings.en %}
{% if page.description %}
  {% assign meta_description = page.description %}
{% else %}
  {% assign meta_description = t_meta.site_description | default: site.description %}
{% endif %}
{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>
  {% if site.title == 'blank' %}
    {% capture title %}{{ author_name }}{% endcapture %}
  {% else %}
    {% capture title %}{{ site.title }}{% endcapture %}
  {% endif %}
  {% if page.url == '/blog/index.html' %}
    {{ page.title }} | {{ title }}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {% if page.title == null or page.title == '' %}
      {{ page.date | date: '%Y' }} | {{ title }}
    {% else %}
      {{ page.title }} | {{ title }}
    {% endif %}
  {% else %}
    {{ title }}
  {% endif %}
</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ meta_description | strip }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ title }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if page.title %}{{ title }} | {{ page.title }}{% else %}{{ title }}{% endif %}">
  <meta property="og:url" content="{{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' }}">
  <meta property="og:description" content="{{ meta_description | strip }}">
  {% if page.og_image or site.og_image %}
    <meta property="og:image" content="{% if page.og_image %}{{ page.og_image }}{% else %}{{ site.og_image }}{% endif %}">
  {% endif %}
  <meta property="og:locale" content="{{ t_meta.og_locale }}">
  {% for tongue in site.languages %}
    {% unless tongue == site.active_lang %}
      <meta property="og:locale:alternate" content="{{ site.data.strings[tongue].og_locale }}">
    {% endunless %}
  {% endfor %}

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if page.title %}{{ page.title }}{% else %}{{ title }}{% endif %}">
  <meta name="twitter:description" content="{{ meta_description | strip }}">
  {% if page.og_image or site.og_image %}
    <meta name="twitter:image" content="{% if page.og_image %}{{ page.og_image }}{% else %}{{ site.og_image }}{% endif %}">
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% comment %} Social links generator for "sameAs schema" {% endcomment %}
  {% assign social = site.data.socials %}
  {% assign sameaslinks = '' | split: ',' %}
  {% if social.orcid_id %}
    {% capture link %}https://orcid.org/{{ social.orcid_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.scholar_userid %}
    {% capture link %}https://scholar.google.com/citations?user={{ social.scholar_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.semanticscholar_id %}
    {% capture link %}https://www.semanticscholar.org/author/{{ social.semanticscholar_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.publons_id %}
    {% capture link %}https://publons.com/a/{{ social.publons_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.lattes_id %}
    {% capture link %}http://lattes.cnpq.br/{{ social.lattes_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.osf_id %}
    {% capture link %}https://osf.io/{{ social.osf_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.research_gate_profile %}
    {% capture link %}https://www.researchgate.net/profile/{{ social.research_gate_profile }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.scopus_id %}
    {% capture link %}https://www.scopus.com/authid/detail.uri?authorId={{ social.scopus_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.github_username %}
    {% capture link %}https://github.com/{{ social.github_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.telegram_username %}
    {% capture link %}https://telegram.me/{{ social.telegram_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.linkedin_username %}
    {% capture link %}https://www.linkedin.com/in/{{ social.linkedin_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.x_username %}
    {% capture link %}https://twitter.com/{{ social.x_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.mastodon_username %}
    {% capture link %}https://{{ social.mastodon_username  }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.medium_username %}
    {% capture link %}https://medium.com/@{{ social.medium_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.quora_username %}
    {% capture link %}https://www.quora.com/profile/{{ social.quora_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.blogger_url %}
    {% capture link %}{{ social.blogger_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.work_url %}
    {% capture link %}{{ social.work_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.wikidata_id %}
    {% capture link %}https://www.wikidata.org/wiki/{{ social.wikidata_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.wikipedia_id %}
    {% capture link %}https://wikipedia.org/wiki/User:{{ social.wikipedia_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.strava_userid %}
    {% capture link %}https://www.strava.com/athletes/{{ social.strava_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.keybase_username %}
    {% capture link %}https://keybase.io/{{ social.keybase_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.gitlab_username %}
    {% capture link %}https://gitlab.com/{{ social.gitlab_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.dblp_url %}
    {% capture link %}{{ social.dblp_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.stackoverflow_id %}
    {% capture link %}https://stackoverflow.com/users/{{ social.stackoverflow_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.kaggle_id %}
    {% capture link %}https://www.kaggle.com/{{ social.kaggle_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.lastfm_id %}
    {% capture link %}https://www.last.fm/user/{{ social.lastfm_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.spotify_id %}
    {% capture link %}https://open.spotify.com/user/{{ social.spotify_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.pinterest_id %}
    {% capture link %}https://www.pinterest.com/{{ social.pinterest_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.unsplash_id %}
    {% capture link %}https://unsplash.com/@{{ social.unsplash_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.instagram_id %}
    {% capture link %}https://instagram.com/{{ social.instagram_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.facebook_id %}
    {% capture link %}https://facebook.com/{{ social.facebook_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.youtube_id %}
    {% capture link %}https://youtube.com/@{{ social.youtube_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.discord_id %}
    {% capture link %}https://discord.com/users/{{ social.discord_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if social.zotero_username %}
    {% capture link %}https://www.zotero.org/{{ social.zotero_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% for profile in site.data.metrics.profiles %}
    {% unless profile[0] == 'scopus' and social.scopus_id %}
      {% assign sameaslinks = sameaslinks | push: profile[1] %}
    {% endunless %}
  {% endfor %}

  {% assign home_page = site.pages | where: 'permalink', '/' | first %}
  {% assign profile_image = home_page.profile.image %}
  {% capture person %}
    {
      "@type": "Person",
      "name": {{ site.full_name | default: author_name | jsonify }},
      "alternateName": {{ author_name | strip | jsonify }},
      "jobTitle": {{ t_meta.job_title | jsonify }},
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Universidade Federal do Rio de Janeiro (COPPE/UFRJ)",
        "url": "https://coppe.ufrj.br"
      },
      {% if profile_image %}"image": {{ profile_image | prepend: '/assets/img/' | absolute_url | jsonify }},{% endif %}
      "knowsAbout": {{ t_meta.knows_about | jsonify }},
      "url": {{ '/' | absolute_url | jsonify }},
      "sameAs": {{ sameaslinks | jsonify }}
    }
  {% endcapture %}

  <script type="application/ld+json">
    {% if page.url == '/' %}
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "url": {{ page.url | absolute_url | jsonify }},
        "inLanguage": {{ site.active_lang | default: site.lang | jsonify }},
        "description": {{ meta_description | strip | jsonify }},
        "mainEntity": {{ person }}
      }
    {% else %}
      {
        "@context": "https://schema.org",
        "@type": "{% if is_blog_post %}BlogPosting{% else %}WebPage{% endif %}",
        "url": {{ page.url | absolute_url | jsonify }},
        "inLanguage": {{ site.active_lang | default: site.lang | jsonify }},
        "headline": {% if page.title %}{{ page.title | jsonify }}{% else %}{{ site.title | jsonify }}{% endif %},
        "description": {{ meta_description | strip | jsonify }},
        "author": {{ person }}
      }
    {% endif %}
  </script>
{% endif %}
